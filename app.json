{
  "expo": {
    "name": "FERVIX",
    "slug": "fervix-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "icon": "./assets/icon.png",

    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F7F6FA",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.fervix.app",
      "permissions": ["CAMERA"]
    },

    "ios": { 
      "supportsTablet": true, 
      "bundleIdentifier": "com.fervix.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to scan QR codes for device activation."
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6FA"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-font", "expo-asset"]
  }
}
